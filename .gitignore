# Claude Code local settings — machine-specific, may capture secrets in allowlisted commands
.claude/settings.local.json

# macOS
.DS_Store

# Xcode user-specific state (UI layout, breakpoints) — not needed in the repo
*.xcuserstate

# Claude Code project instructions — contains the personal Beeminder API key
CLAUDE.md

# Build output
build/
*.xcarchive
*.ipa

# Python bytecode from AppStore/push-metadata.py
__pycache__/

# Watch tour tooling (Tools/tour): Node modules and the generated runner project
Tools/tour/node_modules/
Tools/tour/watch-runner/BeeWatchWatchTour.xcodeproj/
